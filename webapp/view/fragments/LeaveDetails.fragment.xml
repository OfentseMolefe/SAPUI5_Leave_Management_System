<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Leave Details" contentWidth="600px">
        <Table items="{leaveDetails>/}" noDataText="No leave requests found">
            <columns>
                <Column>
                    <Text text="Leave Type" />
                </Column>
                <Column>
                    <Text text="From Date" />
                </Column>
                <Column>
                    <Text text="To Date" />
                </Column>
                <Column>
                    <Text text="Status" />
                </Column>
                <Column>
                    <Text text="Admin Remark" />
                </Column>
                <Column>
                    <Text text="Action" />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{leaveDetails>LeaveType}" />
                        <Text text="{
                          path: 'leaveDetails>FromDate',
                          type: 'sap.ui.model.type.Date',
                          formatOptions: {
                              style: 'medium',
                              source: {
                                  pattern: 'yyyy-MM-dd'
                              }
                          }
                      }" />
                        <Text text="{
                          path: 'leaveDetails>ToDate',
                          type: 'sap.ui.model.type.Date',
                          formatOptions: {
                              style: 'medium',
                              source: {
                                  pattern: 'yyyy-MM-dd'
                              }
                          }
                      }" />
                        <Text text="{
                          path: 'leaveDetails>Status',
                          formatter: '.formatLeaveStatus'
                      }" />
                        <Text text="{leaveDetails>AdminRemark}" />
                            <HBox>
                                <Button 
                                icon="sap-icon://sys-cancel"
                                press="onRevokeLeave" 
                                visible="{
                                    parts: [
                                        {path: 'leaveDetails>Status'},
                                        {path: 'leaveDetails>CreatedDate'}
                                    ],
                                  //  formatter: '.isRevokeVisible'
                                }"/>
                                
                            <Button 
                                icon="sap-icon://edit" 
                                press="onEditLeave" 
                                visible="{
                                    parts: [
                                        {path: 'leaveDetails>Status'},
                                        {path: 'leaveDetails>CreatedDate'}
                                    ],
                                  //  formatter: '.isRevokeVisible'
                                }"/>
                            </HBox>
                    </cells>
                </ColumnListItem>
                
            </items>
        </Table>
        <buttons>
            <Button text="Close" press="onCloseLeaveDetails" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>