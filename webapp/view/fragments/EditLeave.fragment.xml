<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
    <Dialog title="Editing: {leaveDetails>LeaveType}">
        <content>
            <layout:VerticalLayout class="sapUiSmallMargin">
                <Label text="From Date" required="true"/>
                <DatePicker id="fromDate" value="{path: 'leaveApplication>/FromDate', type: 'sap.ui.model.type.Date'}" displayFormat="short" valueFormat="yyyy-MM-dd" 
                    minDate="{ 
                        path: 'leaveApplication>/currentDate',
                        formatter: '.getMinDate'
                    }" change="onDateChange"/>
                
                    <Label text="To Date" required="true" />
                    <DatePicker id="toDate" value="{path: 'leaveApplication>/ToDate', type: 'sap.ui.model.type.Date'}" displayFormat="short" valueFormat="yyyy-MM-dd" minDate="{path: 'leaveApplication>/FromDate'}" change="onDateChange"/>
    
            </layout:VerticalLayout>
        </content>
        <buttons>
            <Button text="Save" press="onSaveEdit" type="Emphasized"/>
            <Button text="Cancel" press="onCancelEdit" type="Reject"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>