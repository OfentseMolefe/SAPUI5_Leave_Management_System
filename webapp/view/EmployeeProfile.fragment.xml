<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog title="Employee Profile" contentWidth="400px">
        <f:SimpleForm editable="false" layout="ResponsiveGridLayout">
            <f:content>
                <Label text="Full Name" />
                <Text text="{employee>/FirstName} {employee>/LastName}" />
                <Label text="Email" />
                <Text text="{employee>/EmailId}" />
                <Label text="Employee ID" />
                <Text text="{employee>/EmpId}" />
                <Label text="Gender" />
                <Text text="{employee>/Gender}" />
                <Label text="Department" />
                <Text text="{employee>/Department}" />
                <Label text="Date of Birth" />
                <Text text="{
                    path: 'employee>/Dob',
                    type: 'sap.ui.model.type.Date',
                    formatOptions: {
                        style: 'medium',
                        source: {
                            pattern: 'yyyy-MM-dd'
                        }
                    }
                }" />
                <Label text="Phone" />
                <Text text="{employee>/Phonenumber}" />
                <Label text="Address" />
                <Text text="{employee>/Address}, {employee>/City}, {employee>/Country}" />
            </f:content>
        </f:SimpleForm>
        <buttons>
            <Button text="Close" press="onCloseProfile" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>