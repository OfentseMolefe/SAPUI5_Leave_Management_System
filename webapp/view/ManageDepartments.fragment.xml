<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Manage Departments" contentWidth="50%">
        <Table id="departmentsTable" items="{/Departments}">
            <columns>
                <Column width="20%"><Text text="Code" /></Column>
                <Column width="30%"><Text text="Name" /></Column>
                <Column width="30%"><Text text="Short Name" /></Column>
                <Column width="20%"><Text text="Actions" /></Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{DepartmentCode}" />
                        <Text text="{DepartmentName}" />
                        <Text text="{DepartmentShortName}" />
                        <HBox justifyContent="Center">
                            <Button 
                                icon="sap-icon://edit" 
                                press="onEditDepartment" 
                                tooltip="Edit"
                                class="sapUiTinyMarginEnd"/>
                            <Button 
                                icon="sap-icon://delete" 
                                press="onDeleteDepartment" 
                                tooltip="Delete"
                                type="Reject"/>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <buttons>
            <Button text="Close" press="onCloseManageDepartments" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>