<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">
    <Dialog
        id="remarksDialog"
        title="{currentLeaveRequest>/dialogTitle}"
        class="sapUiContentPadding">
        <content>
            <l:VerticalLayout class="sapUiMediumMargin">
                <Text 
                    text="{currentLeaveRequest>/actionMessage}" 
                    class="sapUiSmallMarginBottom"/>
                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout">
                    <f:content>
                        <Label text="Remarks" required="true"/>
                        <TextArea 
                            id="adminRemarks" 
                            rows="4" 
                            width="100%" 
                            placeholder="Enter your remarks here"
                            value="{currentLeaveRequest>/remarks}"/>
                    </f:content>
                </f:SimpleForm>
            </l:VerticalLayout>
        </content>
        <beginButton>
            <Button 
                text="{= ${currentLeaveRequest>/action} === 'approve' ? 'Approve' : 'Reject' }" 
                type="Emphasized" 
                press="onSubmitRemarks"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCancelRemarks"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>