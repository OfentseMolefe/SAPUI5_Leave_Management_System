<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        title="Admin Remarks"
        class="sapUiContentPadding">
        <f:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="false">
            <f:content>
                <Label text="Remarks" required="true" />
                <TextArea id="adminRemarks" rows="4" width="100%" placeholder="Enter your remarks here" />
            </f:content>
        </f:SimpleForm>
        <beginButton>
            <Button text="Submit" press=".onSubmitRemarks" type="Emphasized" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelRemarks" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

