<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog title="Add New Employee">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
            <f:content>
                <!-- Add model binding to all fields -->
                <Label text="Employee ID" />
                <Input id="empId" value="{/EmpId}" editable="false" />
                <Label text="First Name" required="true" />
                <Input id="firstName" value="{/FirstName}" />
                <Label text="Last Name" required="true" />
                <Input id="lastName" value="{/LastName}" />
                <Label text="Email ID" required="true" />
                <Input id="emailId" value="{/EmailId}" type="Email" />
                <Label text="Password" required="true" />
                <Input id="password" value="{/Password}" type="Password" />
                <Label text="Gender" required="true" />
                <Select id="gender" selectedKey="{/Gender}">
                    <items>
                        <core:Item key="M" text="Male" />
                        <core:Item key="F" text="Female" />
                    </items>
                </Select>
                <Label text="Date of Birth" required="true" />
                <DatePicker id="dateOfBirth" value="{/DateOfBirth}" />
                <Label text="Department" required="true" />
                <Select id="department" selectedKey="{/Department}" items="{departments>/}">
                    <core:Item key="{departments>DepartmentName}" text="{departments>DepartmentName} ({departments>DepartmentShortName})" />
                </Select>
                <Label text="Address" />
                <Input id="address" value="{/Address}" />
                <Label text="City" />
                <Input id="city" value="{/City}" />
                <Label text="Country" />
                <Input id="country" value="{/Country}" />
                <Label text="Phone Number" />
                <Input id="phoneNumber" value="{/Phonenumber}" />
                <Label text="Status" required="true" />
                <Select id="status" selectedKey="{/Status}">
                    <items>
                        <core:Item key="Active" text="Active" />
                        <core:Item key="Inactive" text="Inactive" />
                    </items>
                </Select>
            </f:content>
        </f:SimpleForm>
        <buttons>
            <Button text="Save" press="onSaveEmployee" type="Emphasized" />
            <Button text="Cancel" press="onCancelAddEmployee" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>